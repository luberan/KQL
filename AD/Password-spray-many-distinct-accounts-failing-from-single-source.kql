// This is a scheduled Microsoft Sentinel analytic rule designed to detect password spraying against on-premises Active Directory. The rule runs every 5 minutes and evaluates the previous 20 minutes to provide a sliding detection window, identifying source IP addresses that generate failed authentication attempts against multiple distinct user accounts.
// Instead of relying on Security Event ID 4625, the detection uses Microsoft Defender for Identity data from `IdentityLogonEvents`, which provides more reliable visibility into failed Kerberos and NTLM authentication attempts across Active Directory.
// The rule also correlates affected identities with Microsoft Entra ID `SigninLogs` to provide additional investigation context, such as related cloud sign-in failures or successful sign-ins. Entra ID activity is intentionally used only as enrichment and is not required to trigger the alert, ensuring that purely on-premises password spray attacks are not missed.
let DetectionWindow = 20m;
let AccountThreshold = 5;
let ADFailures =
    IdentityLogonEvents
    | where TimeGenerated >= ago(DetectionWindow)
    | where Application =~ "Active Directory"
    | where ActionType == "LogonFailed"
    | where FailureReason =~ "WrongPassword"
    | where isnotempty(IPAddress)
    | where isnotempty(AccountSid)
    | where AccountName !endswith "$"
    | project
        ADTime = TimeGenerated,
        SourceIPAddress = tostring(IPAddress),
        AccountName,
        AccountDomain,
        AccountUpn,
        AccountSid,
        AccountObjectId = tostring(AccountObjectId),
        Protocol,
        DeviceName,
        DestinationDeviceName;
let SprayCandidates =
    ADFailures
    | summarize
        StartTime = min(ADTime),
        EndTime = max(ADTime),
        FailedAttempts = count(),
        DistinctAccounts = dcount(AccountSid),
        TargetAccounts = make_set(
            iff(
                isnotempty(AccountUpn),
                AccountUpn,
                strcat(AccountDomain, "\\", AccountName)
            ),
            100
        ),
        TargetAccountSids = make_set(AccountSid, 100),
        TargetObjectIds = make_set_if(
            AccountObjectId,
            isnotempty(AccountObjectId),
            100
        ),
        Protocols = make_set(Protocol, 10),
        AuthenticatingDevices = make_set(DeviceName, 20),
        DestinationDevices = make_set(DestinationDeviceName, 20)
        by SourceIPAddress
    | where DistinctAccounts >= AccountThreshold
    | extend CorrelationIds =
        iff(
            coalesce(array_length(TargetObjectIds), 0) == 0,
            dynamic([""]),
            TargetObjectIds
        );
let EntraActivity =
    SigninLogs
    | where TimeGenerated >= ago(DetectionWindow)
    | where isnotempty(UserId)
    | project
        EntraTime = TimeGenerated,
        UserId = tostring(UserId),
        EntraUserPrincipalName = UserPrincipalName,
        EntraIPAddress = tostring(IPAddress),
        EntraResultType = tostring(ResultType),
        EntraApplication = AppDisplayName;
SprayCandidates
| mv-expand CorrelationId = CorrelationIds to typeof(string)
| join kind=leftouter EntraActivity
    on $left.CorrelationId == $right.UserId
| summarize
    FailedAttempts = take_any(FailedAttempts),
    DistinctAccounts = take_any(DistinctAccounts),
    TargetAccounts = take_any(TargetAccounts),
    TargetAccountSids = take_any(TargetAccountSids),
    TargetObjectIds = take_any(TargetObjectIds),
    Protocols = take_any(Protocols),
    AuthenticatingDevices = take_any(AuthenticatingDevices),
    DestinationDevices = take_any(DestinationDevices),
    EntraRelatedSigninCount =
        countif(isnotempty(EntraTime)),
    EntraPasswordFailureCount =
        countif(EntraResultType == "50126"),
    EntraSuccessfulSigninCount =
        countif(EntraResultType == "0"),
    EntraSameSourcePasswordFailureCount =
        countif(
            EntraResultType == "50126"
            and EntraIPAddress == SourceIPAddress
        ),
    EntraSameSourceSuccessfulSigninCount =
        countif(
            EntraResultType == "0"
            and EntraIPAddress == SourceIPAddress
        ),
    EntraAccounts =
        make_set_if(
            EntraUserPrincipalName,
            isnotempty(EntraUserPrincipalName),
            100
        ),
    EntraSourceIPs =
        make_set_if(
            EntraIPAddress,
            isnotempty(EntraIPAddress),
            50
        ),
    EntraApplications =
        make_set_if(
            EntraApplication,
            isnotempty(EntraApplication),
            50
        )
    by SourceIPAddress, StartTime, EndTime
| extend
    EntraCorrelation = EntraRelatedSigninCount > 0,
    SameSourceEntraCorrelation =
        EntraSameSourcePasswordFailureCount > 0
        or EntraSameSourceSuccessfulSigninCount > 0
| project
    StartTime,
    EndTime,
    SourceIPAddress,
    FailedAttempts,
    DistinctAccounts,
    TargetAccounts,
    Protocols,
    AuthenticatingDevices,
    DestinationDevices,
    EntraCorrelation,
    SameSourceEntraCorrelation,
    EntraRelatedSigninCount,
    EntraPasswordFailureCount,
    EntraSuccessfulSigninCount,
    EntraSameSourcePasswordFailureCount,
    EntraSameSourceSuccessfulSigninCount,
    EntraAccounts,
    EntraSourceIPs,
    EntraApplications
