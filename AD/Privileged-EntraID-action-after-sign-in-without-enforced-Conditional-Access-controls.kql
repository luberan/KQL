// This scheduled analytic rule detects successful Entra ID sign-ins where Conditional Access controls were not effectively enforced and correlates them with subsequent privileged actions in Entra ID, such as privileged role assignments or changes to Conditional Access policies.
// The detection does not treat every ConditionalAccessStatus = notApplied event as a security incident, because this can also occur due to legitimate exclusions or policy scope. Instead, the rule focuses on cases where the lack of enforced Conditional Access is followed by a high-impact administrative action, which provides a much stronger indication that the policy gap may have been used.
let CorrelationWindow = 1h;
let ActionLookback = 15m;
let SignInLookback = CorrelationWindow + ActionLookback;
let SuccessfulSignins =
    union isfuzzy=true
    (
        SigninLogs
        | where TimeGenerated >= ago(SignInLookback)
        | where tostring(ResultType) == "0"
        | project
            SignInTime = TimeGenerated,
            UserId = tolower(tostring(UserId)),
            UserPrincipalName = tolower(tostring(UserPrincipalName)),
            SignInIPAddress = tostring(IPAddress),
            AppDisplayName = tostring(AppDisplayName),
            ResourceDisplayName = tostring(ResourceDisplayName),
            ClientAppUsed = tostring(ClientAppUsed),
            AuthenticationProtocol = tostring(AuthenticationProtocol),
            AuthenticationRequirement = tostring(AuthenticationRequirement),
            ConditionalAccessStatus = tostring(ConditionalAccessStatus),
            CAPolicies = tostring(ConditionalAccessPolicies),
            DeviceInfo = tostring(DeviceDetail),
            SignInType = "Interactive"
    ),
    (
        AADNonInteractiveUserSignInLogs
        | where TimeGenerated >= ago(SignInLookback)
        | where tostring(ResultType) == "0"
        | project
            SignInTime = TimeGenerated,
            UserId = tolower(tostring(UserId)),
            UserPrincipalName = tolower(tostring(UserPrincipalName)),
            SignInIPAddress = tostring(IPAddress),
            AppDisplayName = tostring(AppDisplayName),
            ResourceDisplayName = tostring(ResourceDisplayName),
            ClientAppUsed = tostring(ClientAppUsed),
            AuthenticationProtocol = tostring(AuthenticationProtocol),
            AuthenticationRequirement = tostring(AuthenticationRequirement),
            ConditionalAccessStatus = tostring(ConditionalAccessStatus),
            CAPolicies = tostring(ConditionalAccessPolicies),
            DeviceInfo = tostring(DeviceDetail),
            SignInType = "NonInteractive"
    )
    | where isnotempty(UserId);
let PrivilegedEntraActions =
    AuditLogs
    | where TimeGenerated >= ago(ActionLookback)
    | where Result =~ "success"
    | extend
        ActionActorId = tolower(tostring(InitiatedBy.user.id)),
        ActionActorUPN = tolower(tostring(InitiatedBy.user.userPrincipalName)),
        ActionIPAddress = tostring(InitiatedBy.user.ipAddress),
        ActionName = tostring(ActivityDisplayName)
    | where isnotempty(ActionActorId)
    | where
        (
            Category =~ "RoleManagement"
            and LoggedByService =~ "Core Directory"
            and ActionName =~ "Add member to role"
        )
        or ActionName in~ (
            "Add conditional access policy",
            "Update conditional access policy",
            "Delete conditional access policy"
        )
    | project
        ActionTime = TimeGenerated,
        ActionId = tostring(Id),
        ActionName,
        OperationName,
        LoggedByService,
        ActionActorId,
        ActionActorUPN,
        ActionIPAddress,
        TargetResources,
        AdditionalDetails;
PrivilegedEntraActions
| join kind=inner SuccessfulSignins
    on $left.ActionActorId == $right.UserId
| where SignInTime <= ActionTime
    and ActionTime <= SignInTime + CorrelationWindow
| extend
    SameIPAddress =
        isnotempty(ActionIPAddress)
        and isnotempty(SignInIPAddress)
        and ActionIPAddress == SignInIPAddress
| where isempty(ActionIPAddress) or SameIPAddress
| where isnotempty(ActionIPAddress)
    or AppDisplayName !in~ (
        "Microsoft Authenticator App",
        "Microsoft Authentication Broker"
    )
| summarize arg_max(SignInTime, *) by ActionId
| extend
    NoCAApplied = ConditionalAccessStatus =~ "notApplied",
    LegacyAuthentication =
        ClientAppUsed in~ (
            "Exchange ActiveSync",
            "IMAP",
            "MAPI",
            "SMTP",
            "POP",
            "Other clients"
        )
        or AuthenticationProtocol =~ "ropc"
| where NoCAApplied
| extend
    CAGapReason = case(
        LegacyAuthentication,
            "Legacy authentication / ROPC with no enforced Conditional Access policy",
        "No Conditional Access policy applied"
    ),
    MinutesAfterSignIn =
        datetime_diff("minute", ActionTime, SignInTime)
| project
    ActionTime,
    SignInTime,
    MinutesAfterSignIn,
    UserId,
    UserPrincipalName,
    CAGapReason,
    ConditionalAccessStatus,
    AuthenticationRequirement,
    ClientAppUsed,
    AuthenticationProtocol,
    SignInType,
    SignInIPAddress,
    ActionIPAddress,
    SameIPAddress,
    AppDisplayName,
    ResourceDisplayName,
    ActionName,
    OperationName,
    LoggedByService,
    TargetResources,
    CAPolicies,
    DeviceInfo
| order by ActionTime desc
