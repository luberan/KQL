let DomainControllers =
    _GetWatchlist("DCSyncAllowedSources")
    | where Role =~ "DomainController"
    | where isnotempty(DeviceName)
    | extend
        WatchlistDeviceName = tostring(DeviceName),
        DCName = tolower(tostring(split(tostring(DeviceName), ".")[0]))
    | summarize WatchlistDeviceName = take_any(WatchlistDeviceName) by DCName;
let PerUserServices = dynamic([
    "AarSvc",
    "BcastDVRUserService",
    "BluetoothUserService",
    "CaptureService",
    "cbdhsvc",
    "CloudBackupRestoreSvc",
    "CDPUserSvc",
    "ConsentUxUserSvc",
    "CredentialEnrollmentManagerUserSvc",
    "DeviceAssociationBrokerSvc",
    "DevicePickerUserSvc",
    "DevicesFlowUserSvc",
    "MessagingService",
    "NPSMSvc",
    "OneSyncSvc",
    "P9RdrService",
    "PenService",
    "PimIndexMaintenanceSvc",
    "PrintWorkflowUserSvc",
    "UdkUserSvc",
    "UnistoreSvc",
    "UserDataSvc",
    "webthreatdefusersvc",
    "WpnUserService"
]);
let SystemEvents =
    Event
    | where EventLog =~ "System"
    | where Source =~ "Service Control Manager"
    | where EventID in (7045, 7040)
    | extend DCName = tolower(tostring(split(Computer, ".")[0]))
    | join kind=inner DomainControllers on DCName
    | extend
        EventAction = case(
            EventID == 7045, "Service installed",
            EventID == 7040, "Service start type changed",
            "Unknown"
        ),
        ServiceName = case(
            EventID == 7045,
                extract('<Data Name="ServiceName">([^<]*)</Data>', 1, EventData),
            EventID == 7040,
                extract('<Data Name="param4">([^<]*)</Data>', 1, EventData),
            ""
        ),
        ServiceFileName = iff(
            EventID == 7045,
            extract('<Data Name="ImagePath">([^<]*)</Data>', 1, EventData),
            ""
        ),
        ServiceType = iff(
            EventID == 7045,
            extract('<Data Name="ServiceType">([^<]*)</Data>', 1, EventData),
            ""
        ),
        ServiceStartType = iff(
            EventID == 7045,
            extract('<Data Name="StartType">([^<]*)</Data>', 1, EventData),
            ""
        ),
        PreviousStartType = iff(
            EventID == 7040,
            extract('<Data Name="param2">([^<]*)</Data>', 1, EventData),
            ""
        ),
        NewStartType = iff(
            EventID == 7040,
            extract('<Data Name="param3">([^<]*)</Data>', 1, EventData),
            ""
        ),
        ServiceAccount = iff(
            EventID == 7045,
            extract('<Data Name="AccountName">([^<]*)</Data>', 1, EventData),
            ""
        )
    | extend ServiceBaseName =
        extract(@"^(.+?)_[0-9a-fA-F]+$", 1, ServiceName)
    | extend ServiceBaseName =
        iff(isempty(ServiceBaseName), ServiceName, ServiceBaseName)
    // Exclude standard Windows per-user service instances.
    | where not(
        EventID == 7045
        and ServiceBaseName in~ (PerUserServices)
        and ServiceName matches regex @"_[0-9a-fA-F]+$"
    )
    | extend
        SubjectUserName = "",
        SubjectDomainName = "",
        SubjectUserSid = "",
        SubjectLogonId = "",
        EventSource = "System",
        HostName = tostring(split(Computer, ".")[0]),
        HostDnsDomain = extract(@"^[^.]+\.(.+)$", 1, Computer)
    | project
        TimeGenerated,
        Computer,
        EventID,
        EventAction,
        ServiceName,
        ServiceFileName,
        ServiceType,
        ServiceStartType,
        PreviousStartType,
        NewStartType,
        ServiceAccount,
        SubjectUserName,
        SubjectDomainName,
        SubjectUserSid,
        SubjectLogonId,
        EventSource,
        WatchlistDeviceName,
        HostName,
        HostDnsDomain;
let SecurityEvents =
    SecurityEvent
    | where EventID == 4697
    | extend DCName = tolower(tostring(split(Computer, ".")[0]))
    | join kind=inner DomainControllers on DCName
    // Exclude standard Windows per-user service instances.
    | where tostring(ServiceType) !in~ ("0xd0", "0xe0")
    | extend
        EventAction = "Service installed",
        PreviousStartType = "",
        NewStartType = "",
        EventSource = "Security",
        HostName = tostring(split(Computer, ".")[0]),
        HostDnsDomain = extract(@"^[^.]+\.(.+)$", 1, Computer)
    | project
        TimeGenerated,
        Computer,
        EventID,
        EventAction,
        ServiceName = tostring(ServiceName),
        ServiceFileName = tostring(ServiceFileName),
        ServiceType = tostring(ServiceType),
        ServiceStartType = tostring(ServiceStartType),
        PreviousStartType,
        NewStartType,
        ServiceAccount = tostring(ServiceAccount),
        SubjectUserName = tostring(SubjectUserName),
        SubjectDomainName = tostring(SubjectDomainName),
        SubjectUserSid = tostring(SubjectUserSid),
        SubjectLogonId = tostring(SubjectLogonId),
        EventSource,
        WatchlistDeviceName,
        HostName,
        HostDnsDomain;
union SystemEvents, SecurityEvents
// Normalize path for precise benign-pattern matching.
| extend NormalizedServicePath =
    tolower(replace_string(tostring(ServiceFileName), '"', ''))
// Azure Update Manager WindowsPatchExtension.
| extend IsAzureUpdateManagerService =
    EventID in (4697, 7045)
    and ServiceName =~ "AutoAssessPatchService"
    and NormalizedServicePath startswith
        @"c:\packages\plugins\microsoft.cplat.core.windowspatchextension\"
    and NormalizedServicePath endswith
        @"\bin\autoassesspatchservice.exe"
    and ServiceAccount in~ ("LocalSystem", "Local System")
    and (
        EventID == 7045
        or SubjectUserSid == "S-1-5-18"
    )
// Known Microsoft Defender KslD driver registration.
// Suppress only the expected driver name, path, account and startup configuration.
| extend IsKnownDefenderKslD =
    EventID in (4697, 7045)
    and ServiceName =~ "KslD"
    and NormalizedServicePath endswith @"system32\drivers\wd\ksld.sys"
    and ServiceAccount in~ ("LocalSystem", "Local System")
    and (
        // Security Event 4697 represents Demand Start as 3.
        (
            EventID == 4697
            and ServiceStartType == "3"
            and SubjectUserSid == "S-1-5-18"
        )
        or
        // System Event 7045 contains rendered startup type text.
        (
            EventID == 7045
            and ServiceStartType =~ "demand start"
        )
    )
| where IsAzureUpdateManagerService == false
    and IsKnownDefenderKslD == false
| project-away
    NormalizedServicePath,
    IsAzureUpdateManagerService,
    IsKnownDefenderKslD
| order by TimeGenerated desc
